<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">PELAKSANAAN TES</div><h1>Sesi Kuesioner</h1><p>Kelola sesi, pemohon, peserta, dan status akses.</p></div><a class="btn btn-primary" href="/admin/sesi/tambah">+ Buat Sesi</a></div>
<% if (notice === 'updated') { %><div class="alert alert-success">Pengelolaan sesi berhasil diperbarui.</div><% } %>
<section class="content-card"><form class="toolbar" method="get" action="/admin/sesi"><div class="search-wrap"><span>⌕</span><input class="form-control" name="q" value="<%= q %>" placeholder="Cari kode sesi, nama peserta, atau HP..."></div><button class="btn btn-primary" type="submit">Cari</button><span class="result-count"><%= rows.length %> data terbaru</span></form>
<div class="table-responsive"><table class="table align-middle app-table"><thead><tr><% fields.forEach(field => { %><th><%= field.replaceAll('_',' ') %></th><% }) %><th>Aksi</th></tr></thead><tbody><% if (!rows.length) { %><tr><td colspan="<%= fields.length + 1 %>" class="text-center py-5 text-muted">Belum ada sesi kuesioner.</td></tr><% } %><% rows.forEach(row => { %><tr><% fields.forEach(field => { %><td><% const val = row[field]; if (val instanceof Date || ['tanggal_tes','created_at'].includes(field) && val) { %><%= new Date(val).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %><% } else if (val === null || val === undefined || val === '') { %><span class="text-muted">—</span><% } else { %><%= String(val) %><% } %></td><% }) %><td><a class="btn btn-sm btn-primary" href="/admin/sesi/<%= row.sesi_id %>/detail">Detail / Penilaian</a> <a class="btn btn-sm btn-outline-primary" href="/admin/sesi/<%= row.sesi_id %>/kelola">Kelola</a></td></tr><% }) %></tbody></table></div>
<div class="notice-box mt-3"><b>Keamanan akses</b><p>Token QR dan PIN hanya ditampilkan sekali saat sesi dibuat. Sesi yang sudah berjalan tidak dapat dihapus dari halaman ini; gunakan pengarsipan agar riwayat tetap terjaga.</p></div></section>
