<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">PELAKSANAAN TES</div><h1>Buat Sesi Kuesioner</h1><p>Satu sesi dapat berisi beberapa versi kuesioner. Token QR dan PIN akan ditampilkan satu kali setelah dibuat.</p></div><a class="btn btn-outline-secondary" href="/admin/sesi">Kembali</a></div>
<section class="content-card form-card">
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (!pemohon.length) { %><div class="notice-box"><b>Belum ada pemohon aktif</b><p>Tambahkan pemohon terlebih dahulu sebelum membuat sesi.</p><a class="btn btn-sm btn-primary mt-3" href="/admin/pemohon/tambah">Tambah Pemohon</a></div><% } else { %>
  <form method="post" action="/admin/sesi">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 class="h5 mb-3">Data Peserta</h2><div class="row g-3">
      <div class="col-md-6"><label class="form-label" for="pemohon_id">Pemohon *</label><select class="form-select" id="pemohon_id" name="pemohon_id" required><option value="">Pilih pemohon...</option><% pemohon.forEach(p => { %><option value="<%= p.pemohon_id %>" <%= String(item.pemohon_id || '') === String(p.pemohon_id) ? 'selected' : '' %>><%= p.nama_pemohon %><%= p.no_hp ? ' · ' + p.no_hp : '' %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label" for="nama_peserta">Nama Peserta *</label><input class="form-control" id="nama_peserta" name="nama_peserta" value="<%= item.nama_peserta || '' %>" required maxlength="150"></div>
      <div class="col-md-4"><label class="form-label" for="no_hp_peserta">Nomor HP Peserta</label><input class="form-control" id="no_hp_peserta" name="no_hp_peserta" type="tel" value="<%= item.no_hp_peserta || '' %>" maxlength="40"></div>
      <div class="col-md-4"><label class="form-label" for="tanggal_lahir">Tanggal Lahir *</label><input class="form-control" id="tanggal_lahir" name="tanggal_lahir" type="date" value="<%= item.tanggal_lahir || '' %>" required max="<%= new Date().toISOString().slice(0,10) %>"></div>
      <div class="col-md-4"><label class="form-label" for="tanggal_tes">Tanggal Tes *</label><input class="form-control" id="tanggal_tes" name="tanggal_tes" type="date" value="<%= item.tanggal_tes || new Date().toISOString().slice(0,10) %>" required></div>
      <div class="col-md-6"><label class="form-label" for="jenis_kelamin">Jenis Kelamin</label><select class="form-select" id="jenis_kelamin" name="jenis_kelamin"><option value="">Tidak diisi</option><% [['perempuan','Perempuan'],['laki_laki','Laki-laki'],['lainnya','Lainnya'],['tidak_diketahui','Tidak diketahui']].forEach(o => { %><option value="<%= o[0] %>" <%= item.jenis_kelamin === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></div>
      <div class="col-12"><label class="form-label" for="catatan_admin">Catatan Admin</label><textarea class="form-control" id="catatan_admin" name="catatan_admin" rows="2" maxlength="2000"><%= item.catatan_admin || '' %></textarea></div>
    </div>
    <hr class="my-4"><h2 class="h5 mb-2">Pilih Versi Kuesioner *</h2><p class="text-muted small">Daftar hanya menampilkan versi yang sudah diterbitkan. Usia peserta akan divalidasi otomatis berdasarkan tanggal lahir dan tanggal tes.</p>
    <% if (!versions.length) { %><div class="alert alert-warning">Belum ada versi kuesioner yang dapat digunakan. Pastikan versi berstatus <code>diterbitkan</code> dan master kuesionernya aktif.</div><% } else { %><div class="row g-3"><% versions.forEach(v => { %><div class="col-md-6"><label class="version-choice"><input type="checkbox" name="versi_ids" value="<%= v.versi_id %>" <%= (Array.isArray(item.versi_ids) ? item.versi_ids : [item.versi_ids]).map(String).includes(String(v.versi_id)) ? 'checked' : '' %>><span><b><%= v.nama_master || 'Kuesioner' %> <%= v.kode_versi ? '· ' + v.kode_versi : '' %></b><small>Usia <%= v.usia_min %>–<%= v.usia_max === null || v.usia_max === undefined ? 'tanpa batas maksimum' : v.usia_max %> tahun<%= v.jumlah_pertanyaan ? ' · ' + v.jumlah_pertanyaan + ' pertanyaan' : '' %></small></span></label></div><% }) %></div><% } %>
    <div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="/admin/sesi">Batal</a><button class="btn btn-primary" type="submit" <%= !versions.length ? 'disabled' : '' %>>Buat Sesi &amp; Buat QR/PIN</button></div>
  </form><% } %>
</section>
