<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">HASIL TES</div><h1>Rincian Skor</h1><p><b><%= hasil.kode_sesi %></b> · <%= hasil.nama_peserta %> · <%= hasil.nama_kuesioner %> — <%= hasil.nama_versi %></p></div><a class="btn btn-outline-secondary" href="/admin/sesi/<%= hasil.sesi_id %>/detail">Kembali ke Detail Sesi</a></div>
<% if (notice === 'calculated') { %><div class="alert alert-success">Nilai berhasil dihitung. Periksa rincian di bawah sebelum menerbitkan hasil.</div><% } %>
<section class="content-card mb-4"><div class="row g-3"><div class="col-md-4"><small class="text-muted">Kode hasil</small><div class="h4"><%= hasil.kode_hasil || hasil.tipe_hasil || hasil.tipe_kepribadian || '—' %></div></div><div class="col-md-4"><small class="text-muted">Status hasil</small><div><%= hasil.status_hasil %></div></div><div class="col-md-4"><small class="text-muted">Tanggal tes</small><div><%= hasil.tanggal_tes ? String(hasil.tanggal_tes).slice(0,10) : '—' %></div></div></div></section>
<section class="content-card"><h2 class="h5">Rincian Skor per Dimensi</h2><div class="table-responsive"><table class="table"><thead><tr><th>Dimensi</th><th>Sisi A</th><th>Sisi B</th><th>Preferensi</th><th>Selisih (%)</th></tr></thead><tbody><% dimensions.forEach(d => { %><tr><td><b><%= d.nama_dimensi || d.kode_dimensi %></b></td><td><%= d.skor_sisi_a ?? d.skor_a ?? d.nilai_sisi_a ?? '—' %></td><td><%= d.skor_sisi_b ?? d.skor_b ?? d.nilai_sisi_b ?? '—' %></td><td><%= d.kode_hasil || 'imbang' %></td><td><%= d.skor_persentase ?? '—' %></td></tr><% }) %></tbody></table></div>
<% if (hasil.status_hasil !== 'diterbitkan') { %><form method="post" action="/admin/sesi/<%= hasil.sesi_id %>/tes/<%= hasil.sesi_detail_id %>/terbitkan" onsubmit="return confirm('Terbitkan hasil tes ini? Peserta akan dapat mengunduh PDF melalui QR dan PIN sesi.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit">Terbitkan Hasil</button></form><% } else { %><a class="btn btn-outline-primary" target="_blank" href="/admin/sesi/<%= hasil.sesi_id %>/tes/<%= hasil.sesi_detail_id %>/hasil.pdf">Lihat PDF</a> <a class="btn btn-primary" href="/admin/sesi/<%= hasil.sesi_id %>/tes/<%= hasil.sesi_detail_id %>/hasil.pdf?download=1">Unduh PDF</a><% } %></section>