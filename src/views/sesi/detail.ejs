<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">PENGELOLAAN SESI</div><h1>Detail Sesi</h1><p><b><%= sesi.kode_sesi %></b> · <%= sesi.nama_peserta %></p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-secondary" href="/admin/sesi">Kembali ke Sesi</a><form method="post" action="/admin/sesi/<%= sesi.sesi_id %>/akses-baru" onsubmit="return confirm('Buat QR dan PIN baru? QR/PIN lama langsung tidak berlaku, tetapi sesi, jawaban, dan hasil tes tetap ada.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" type="submit">Buat QR &amp; PIN Baru</button></form></div></div>
<% if (notice === 'reset') { %><div class="alert alert-success">Tes sudah direset. Jawaban, hasil, dan laporan tes ini dihapus; tes lain tidak berubah.</div><% } %>
<% if (notice === 'published') { %><div class="alert alert-success">Hasil telah diterbitkan. Peserta dapat mengunduh PDF melalui QR dan PIN sesi.</div><% } %>
<section class="content-card mb-4"><h2 class="h5 mb-3">Informasi Sesi</h2><div class="row g-3"><div class="col-md-3"><small class="text-muted">Tanggal tes</small><div><%= sesi.tanggal_tes ? new Date(sesi.tanggal_tes).toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'}) : '—' %></div></div><div class="col-md-3"><small class="text-muted">Status sesi</small><div><%= sesi.status_sesi %></div></div><div class="col-md-3"><small class="text-muted">Pengelolaan</small><div><%= sesi.status_pengelolaan %></div></div><div class="col-md-3"><small class="text-muted">Akses hasil</small><div><%= sesi.status_akses_hasil %></div></div></div><p class="small text-muted mt-3 mb-0">QR/PIN hanya ditampilkan saat sesi dibuat atau saat Anda membuat akses baru. Untuk menguji, scan QR dengan HP lalu masukkan PIN yang tampil di halaman akses baru.</p></section>
<section class="content-card"><h2 class="h5 mb-3">Daftar Tes dalam Sesi</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Jenis / Versi Tes</th><th>Status Pengerjaan</th><th>Jawaban</th><th>Status Hasil</th><th>Tindakan</th></tr></thead><tbody>
<% if (!details.length) { %><tr><td colspan="5" class="text-muted text-center py-4">Belum ada tes dalam sesi ini.</td></tr><% } %>
<% details.forEach(d => { %><tr><td><b><%= d.nama_kuesioner %></b><div class="small text-muted"><%= d.nama_versi || d.kode_versi %></div></td><td><%= d.status_pengerjaan %></td><td><%= d.jumlah_jawaban %></td><td><%= d.status_hasil || 'belum dihitung' %></td><td><div class="d-flex gap-2 flex-wrap">
<% if (d.status_pengerjaan === 'selesai' && d.status_hasil !== 'diterbitkan') { %><form method="post" action="/admin/sesi/<%= sesi.sesi_id %>/tes/<%= d.sesi_detail_id %>/hitung" onsubmit="return confirm('Hitung ulang nilai tes ini? Hasil draf lama akan diganti.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-primary" type="submit">Hitung Nilai</button></form><% } %>
<% if (d.status_hasil) { %><a class="btn btn-sm btn-outline-secondary" href="/admin/sesi/<%= sesi.sesi_id %>/tes/<%= d.sesi_detail_id %>/hasil">Rincian Skor</a><% } %>
<% if (d.status_hasil === 'diterbitkan') { %><a class="btn btn-sm btn-outline-primary" target="_blank" href="/admin/sesi/<%= sesi.sesi_id %>/tes/<%= d.sesi_detail_id %>/hasil.pdf">Lihat PDF</a><a class="btn btn-sm btn-primary" href="/admin/sesi/<%= sesi.sesi_id %>/tes/<%= d.sesi_detail_id %>/hasil.pdf?download=1">Unduh PDF</a><% } %>
<form method="post" action="/admin/sesi/<%= sesi.sesi_id %>/tes/<%= d.sesi_detail_id %>/ulang" onsubmit="return confirm('Batalkan dan izinkan ulang tes ini? Semua jawaban, hasil, dan laporan tes ini akan dihapus permanen. Tes lain tidak berubah.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" type="submit">Batalkan / Izinkan Ulang</button></form></div></td></tr><% }) %>
</tbody></table></div><div class="notice-box mt-3"><b>Catatan</b><p class="mb-0">Setiap PDF dibuat terpisah untuk setiap tes. Mengulang tes menghapus jawaban dan hasil tes terpilih tanpa menyimpan salinan hasil lama; QR/PIN sesi dan tes lain tetap dipertahankan.</p></div></section>