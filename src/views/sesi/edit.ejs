<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">PELAKSANAAN TES</div><h1>Kelola Sesi <%= item.kode_sesi %></h1><p>Data identitas peserta tidak diubah di halaman ini untuk menjaga jejak transaksi sesi.</p></div><a class="btn btn-outline-secondary" href="/admin/sesi">Kembali</a></div>
<section class="content-card form-card"><form method="post" action="/admin/sesi/<%= item.sesi_id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">Status Pengelolaan</label><select class="form-select" name="status_pengelolaan"><option value="aktif" <%= item.status_pengelolaan === 'aktif' ? 'selected' : '' %>>Aktif</option><option value="diarsipkan" <%= item.status_pengelolaan === 'diarsipkan' ? 'selected' : '' %>>Diarsipkan</option></select></div><div class="mb-3"><label class="form-label">Status Sesi</label><select class="form-select" name="status_sesi"><% [['draf','Draf'],['aktif','Aktif'],['menunggu_admin','Menunggu Admin'],['diproses','Diproses'],['hasil_terbit','Hasil Terbit'],['dibatalkan','Dibatalkan']].forEach(o => { %><option value="<%= o[0] %>" <%= item.status_sesi === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></div><div class="mb-3"><label class="form-label">Catatan Admin</label><textarea class="form-control" name="catatan_admin" rows="4"><%= item.catatan_admin || '' %></textarea></div><p class="small text-muted">Status pengerjaan saat ini: <b><%= item.status_sesi %></b>. Perubahan status pengelolaan tidak menghapus sesi atau jawaban.</p><div class="d-flex justify-content-end"><button class="btn btn-primary">Simpan Perubahan</button></div></form></section>
