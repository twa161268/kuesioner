<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">KONFIGURASI INSTRUMEN</div><h1>Master Kuesioner</h1><p>Kelola identitas instrumen yang digunakan untuk membuat versi kuesioner.</p></div><a class="btn btn-primary" href="/admin/kuesioner/tambah">+ Tambah Kuesioner</a></div>
<% if (notice) { %><div class="alert alert-success"><%= notice === 'created' ? 'Master kuesioner berhasil ditambahkan.' : 'Master kuesioner berhasil diperbarui.' %></div><% } %>
<section class="content-card"><form class="toolbar" method="get" action="/admin/kuesioner"><div class="search-wrap"><span>⌕</span><input class="form-control" name="q" value="<%= q %>" placeholder="Cari kode atau nama kuesioner..."></div><button class="btn btn-primary">Cari</button><span class="result-count"><%= rows.length %> instrumen ditampilkan</span></form><div class="table-responsive"><table class="table align-middle app-table"><thead><tr><% fields.forEach(field => { %><th><%= field.replaceAll('_',' ') %></th><% }) %><th>Aksi</th></tr></thead><tbody><% if (!rows.length) { %><tr><td colspan="<%= fields.length + 1 %>" class="text-center py-5 text-muted">Belum ada master kuesioner.</td></tr><% } %><% rows.forEach(row => { %><tr><% fields.forEach(field => { %><td><% const val = row[field]; if (field === 'status') { %><span class="status-pill <%= val === 'aktif' ? 'status-active' : 'status-inactive' %>"><%= val %></span><% } else if (field === 'created_at' && val) { %><%= new Date(val).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %><% } else if (val === null || val === undefined || val === '') { %><span class="text-muted">—</span><% } else { %><%= String(val) %><% } %></td><% }) %><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" href="/admin/kuesioner/<%= row.kuesioner_id %>/ubah">Ubah</a><a class="btn btn-sm btn-primary" href="/admin/versi?kuesioner_id=<%= row.kuesioner_id %>">Kelola Versi</a></div></td></tr><% }) %></tbody></table></div><div class="notice-box mt-3"><b>Catatan</b><p>Penghapusan fisik tidak disediakan karena master dapat direferensikan versi, sesi, dan hasil. Gunakan status nonaktif atau arsip untuk menjaga integritas data.</p></div></section>
