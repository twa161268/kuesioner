<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">KONFIGURASI INSTRUMEN</div><h1><%= mode === 'create' ? 'Tambah Kuesioner' : 'Ubah Kuesioner' %></h1><p>Kelola identitas master kuesioner. Versi, pertanyaan, dimensi, dan aturan skor dikelola terpisah.</p></div><a class="btn btn-outline-secondary" href="/admin/kuesioner">Kembali</a></div>
<section class="content-card form-card"><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="<%= mode === 'create' ? '/admin/kuesioner' : '/admin/kuesioner/' + item.kuesioner_id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><% fields.forEach(field => { %><div class="col-12"><label class="form-label" for="f_<%= field.name %>"><%= field.label %><%= field.required ? ' *' : '' %></label><% if (field.type === 'select') { %><select class="form-select" id="f_<%= field.name %>" name="<%= field.name %>"><% field.options.forEach(opt => { %><option value="<%= opt %>" <%= String(item[field.name] || 'draft') === opt ? 'selected' : '' %>><%= opt %></option><% }) %></select><% } else if (field.type === 'textarea') { %><textarea class="form-control" id="f_<%= field.name %>" name="<%= field.name %>" rows="4"><%= item[field.name] || '' %></textarea><% } else { %><input class="form-control" id="f_<%= field.name %>" name="<%= field.name %>" value="<%= item[field.name] || '' %>" <%= field.required ? 'required' : '' %> maxlength="200"><% } %></div><% }) %></div><div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="/admin/kuesioner">Batal</a><button class="btn btn-primary">Simpan</button></div></form></section>
