<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">PENGELOLAAN INSTRUMEN TES</div><h1><%= title %></h1><p>Kelola konfigurasi berdasarkan master dan versi kuesioner. Data yang sudah dipakai pada transaksi atau hasil dapat dilindungi oleh relasi database.</p></div><a class="btn btn-primary" href="/admin/<%= resource %>/tambah<%= Object.keys(context).length ? '?' + new URLSearchParams(context).toString() : '' %>">+ Tambah <%= title %></a></div>
<% if (notice) { %><div class="alert <%= notice === 'delete_failed' ? 'alert-warning' : 'alert-success' %>"><%= ({created:'Data berhasil ditambahkan.',updated:'Data berhasil diperbarui.',deleted:'Data berhasil dihapus.',missing:'Data tidak ditemukan.',delete_failed:'Data tidak dapat dihapus karena masih digunakan oleh data lain atau dibatasi relasi database.'})[notice] || notice %></div><% } %>
<div class="content-card mb-3">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <div><strong>Menu Pengelolaan Instrumen</strong><div class="small text-muted">Kelola versi, dimensi, soal, pilihan jawaban, dan aturan penilaian.</div></div>
    <% if (resource === 'versi' && context.kuesioner_id) { %><a class="btn btn-sm btn-outline-secondary" href="/admin/kuesioner/<%= context.kuesioner_id %>/ubah">Kembali ke Master</a><% } %>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-sm <%= resource === 'versi' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/versi<%= context.kuesioner_id ? '?kuesioner_id=' + context.kuesioner_id : '' %>">Versi Kuesioner</a>
    <a class="btn btn-sm <%= resource === 'dimensi' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/dimensi<%= context.versi_id ? '?versi_id=' + context.versi_id : '' %>">Dimensi</a>
    <a class="btn btn-sm <%= resource === 'pertanyaan' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/pertanyaan<%= context.versi_id ? '?versi_id=' + context.versi_id : '' %>">Pertanyaan</a>
    <a class="btn btn-sm <%= resource === 'pilihan' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/pilihan<%= context.pertanyaan_id ? '?pertanyaan_id=' + context.pertanyaan_id : '' %>">Pilihan Jawaban</a>
    <a class="btn btn-sm <%= resource === 'skor' ? 'btn-primary' : 'btn-outline-primary' %>" href="/admin/skor<%= context.versi_id ? '?versi_id=' + context.versi_id : '' %>">Aturan Skor</a>
  </div>
  <% if (['dimensi','pertanyaan','skor'].includes(resource) && !context.versi_id) { %><div class="small text-muted mt-2">Tips: pilih versi kuesioner terlebih dahulu agar data yang ditampilkan terfilter ke versi tersebut.</div><% } %>
  <% if (resource === 'pilihan' && !context.pertanyaan_id) { %><div class="small text-muted mt-2">Tips: pilihan jawaban terkait dengan satu pertanyaan. Untuk mengelola pilihan dari soal tertentu, buka menu Pertanyaan lalu klik Pilihan pada baris soal tersebut.</div><% } %>
</div>
<section class="content-card"><form class="toolbar" method="get" action="/admin/<%= resource %>"><% Object.entries(context).forEach(([k,v])=>{ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %><div class="search-wrap"><span>⌕</span><input class="form-control" name="q" value="<%= q %>" placeholder="Cari data..."></div><button class="btn btn-primary">Cari</button><span class="result-count"><%= rows.length %> data ditampilkan</span></form>
<div class="table-responsive"><table class="table align-middle app-table"><thead><tr><% fields.forEach(field => { %><th><%= ({_master:'Master Kuesioner',_versi:'Versi',_pertanyaan:'Pertanyaan',_dimensi:'Dimensi'})[field] || field.replaceAll('_',' ') %></th><% }) %><th>Aksi</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="<%= fields.length + 1 %>" class="text-center py-5 text-muted">Belum ada data. Klik tombol Tambah untuk mulai mengisi.</td></tr><% } %>
<% rows.forEach(row => { %><tr><% fields.forEach(field => { %><td><% let val = row[field]; if (field === '_master') val = row._master; if (field === '_versi') val = row._versi; if (field === '_pertanyaan') val = row._pertanyaan; if (field === '_dimensi') val = row._dimensi; if (field === 'status' && val) { %><span class="status-pill <%= ['aktif','diterbitkan'].includes(val) ? 'status-active' : 'status-inactive' %>"><%= val %></span><% } else if ((field === 'created_at' || field === 'updated_at') && val) { %><%= new Date(val).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %><% } else if (val === null || val === undefined || val === '') { %><span class="text-muted">—</span><% } else { %><%= String(val) %><% } %></td><% }) %><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" href="/admin/<%= resource %>/<%= row[config.pk] %>/ubah">Ubah</a>
<% if (resource === 'versi') { %><a class="btn btn-sm btn-outline-secondary" href="/admin/dimensi?versi_id=<%= row.versi_id %>">Dimensi</a><a class="btn btn-sm btn-outline-secondary" href="/admin/pertanyaan?versi_id=<%= row.versi_id %>">Pertanyaan</a><a class="btn btn-sm btn-outline-secondary" href="/admin/skor?versi_id=<%= row.versi_id %>">Skor</a><% } %>
<% if (resource === 'pertanyaan') { %><a class="btn btn-sm btn-outline-secondary" href="/admin/pilihan?pertanyaan_id=<%= row.pertanyaan_id %>">Pilihan</a><% } %>
<form method="post" action="/admin/<%= resource %>/<%= row[config.pk] %>/hapus" onsubmit="return confirm('Yakin ingin menghapus data ini? Jika sudah direferensikan, database akan menolak penghapusan.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger">Hapus</button></form></div></td></tr><% }) %></tbody></table></div>
<div class="notice-box mt-3"><b>Catatan</b><p>Penghapusan mengikuti foreign key database. Jika data sudah dipakai oleh versi, sesi, jawaban, atau hasil, penghapusan akan ditolak agar riwayat tetap aman.</p></div></section>
