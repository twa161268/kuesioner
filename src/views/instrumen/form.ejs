<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">KONFIGURASI INSTRUMEN</div><h1><%= mode === 'create' ? 'Tambah ' : 'Ubah ' %><%= config.title %></h1><p>Isi data sesuai versi dan metode penilaian yang sedang dikelola.</p></div><a class="btn btn-outline-secondary" href="/admin/<%= resource %><%= Object.keys(context).length ? '?' + new URLSearchParams(context).toString() : '' %>">Kembali</a></div>
<section class="content-card form-card"><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="<%= mode === 'create' ? '/admin/' + resource + (Object.keys(context).length ? '?' + new URLSearchParams(context).toString() : '') : '/admin/' + resource + '/' + item[config.pk] %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3">
<% fields.forEach(field => { %><div class="col-12 col-md-6"><label class="form-label" for="f_<%= field.name %>"><%= field.label %><%= field.required ? ' *' : '' %></label>
<% if (field.type === 'select') { %><select class="form-select" id="f_<%= field.name %>" name="<%= field.name %>" <%= field.required ? 'required' : '' %>><% if (!field.required) { %><option value="">— Tidak dipilih —</option><% } %><% if (field.options) { field.options.forEach(opt => { const ov = typeof opt === 'object' ? opt.id : opt; const ol = typeof opt === 'object' ? opt.label : opt; %><option value="<%= ov %>" <%= String(item[field.name] ?? field.defaultValue ?? '') === String(ov) ? 'selected' : '' %>><%= ol %></option><% }) } else { %><option value="">Pilih status</option><% } %></select>
<% } else if (field.type === 'textarea') { %><textarea class="form-control" id="f_<%= field.name %>" name="<%= field.name %>" rows="4" <%= field.required ? 'required' : '' %>><%= item[field.name] ?? '' %></textarea>
<% } else if (field.type === 'checkbox') { %><div class="form-check"><input class="form-check-input" type="checkbox" id="f_<%= field.name %>" name="<%= field.name %>" value="true" <%= item[field.name] ? 'checked' : '' %>><label class="form-check-label" for="f_<%= field.name %>">Ya</label></div>
<% } else { %><input class="form-control" type="<%= field.type %>" id="f_<%= field.name %>" name="<%= field.name %>" value="<%= item[field.name] ?? '' %>" <%= field.required ? 'required' : '' %> <%= field.type === 'number' ? 'step="any"' : '' %>><% } %>
</div><% }) %></div><div class="d-flex justify-content-end gap-2 mt-4"><a class="btn btn-outline-secondary" href="/admin/<%= resource %><%= Object.keys(context).length ? '?' + new URLSearchParams(context).toString() : '' %>">Batal</a><button class="btn btn-primary">Simpan</button></div></form></section>
