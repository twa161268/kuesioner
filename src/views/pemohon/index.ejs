<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">DATA MASTER</div><h1>Pemohon</h1><p>Kelola data pemohon yang dapat meminta pelaksanaan kuesioner.</p></div><a class="btn btn-primary" href="/admin/pemohon/tambah">+ Tambah Pemohon</a></div>
<% if (notice) { %><div class="alert alert-success"><%= notice === 'created' ? 'Data pemohon berhasil ditambahkan.' : notice === 'updated' ? 'Data pemohon berhasil diperbarui.' : 'Status pemohon berhasil diperbarui.' %></div><% } %>
<section class="content-card"><form class="toolbar" method="get" action="/admin/pemohon"><div class="search-wrap"><span>⌕</span><input class="form-control" name="q" value="<%= q %>" placeholder="Cari nama, nomor HP, atau email..."></div><button class="btn btn-primary" type="submit">Cari</button><span class="result-count"><%= total %> data</span></form>
<div class="table-responsive"><table class="table align-middle app-table"><thead><tr><% fields.forEach(field => { %><th><%= field.replaceAll('_',' ') %></th><% }) %><th>Aksi</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="<%= fields.length + 1 %>" class="text-center py-5 text-muted">Belum ada data pemohon.</td></tr><% } %>
<% rows.forEach(row => { %><tr><% fields.forEach(field => { %><td><% const val = row[field]; if (field === 'status') { %><span class="status-pill <%= val === 'aktif' ? 'status-active' : 'status-inactive' %>"><%= val %></span><% } else if (field === 'created_at' && val) { %><%= new Date(val).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %><% } else if (val === null || val === undefined || val === '') { %><span class="text-muted">—</span><% } else { %><%= String(val) %><% } %></td><% }) %><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="/admin/pemohon/<%= row.pemohon_id %>/ubah">Ubah</a><% if (fields.includes('status')) { %><form method="post" action="/admin/pemohon/<%= row.pemohon_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-secondary" type="submit"><%= row.status === 'aktif' ? 'Nonaktifkan' : 'Aktifkan' %></button></form><% } %></div></td></tr><% }) %>
</tbody></table></div>
<div class="pagination-row"><span>Halaman <%= page %> dari <%= Math.max(1, Math.ceil(total / limit)) %></span><div class="d-flex gap-2"><% if (page > 1) { %><a class="btn btn-sm btn-outline-secondary" href="?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>">Sebelumnya</a><% } %><% if (page * limit < total) { %><a class="btn btn-sm btn-outline-secondary" href="?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>">Berikutnya</a><% } %></div></div></section>
