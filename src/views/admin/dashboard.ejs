<% layout('layouts/main') -%>
<div class="page-heading"><div><div class="eyebrow">RINGKASAN OPERASIONAL</div><h1>Dashboard</h1><p>Selamat datang kembali. Berikut gambaran aktivitas aplikasi.</p></div><span class="date-pill"><%= new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}) %></span></div>
<div class="row g-3 mb-4">
<% const cards = [{label:'Total Pemohon',value:stats.pemohon,icon:'◎',tone:'purple'},{label:'Sesi Aktif',value:stats.sesiAktif,icon:'↗',tone:'blue'},{label:'Menunggu Admin',value:stats.menunggu,icon:'◷',tone:'orange'},{label:'Hasil Terbit',value:stats.hasilTerbit,icon:'✓',tone:'green'}]; cards.forEach(card => { %>
<div class="col-6 col-xl-3"><div class="stat-card"><div class="stat-top"><span><%= card.label %></span><span class="stat-icon <%= card.tone %>"><%= card.icon %></span></div><div class="stat-value"><%= card.value %></div><div class="stat-caption">Data dari database aplikasi</div></div></div><% }) %></div>
<div class="row g-3"><div class="col-xl-8"><section class="content-card h-100"><div class="card-heading"><div><h2>Mulai dari sini</h2><p>Pilih area kerja yang ingin dibuka.</p></div></div><div class="quick-links"><a href="/admin/pemohon"><span class="quick-icon">01</span><span><b>Data Pemohon</b><small>Lihat dan cari data pemohon</small></span><span class="arrow">↗</span></a><a href="/admin/sesi"><span class="quick-icon">02</span><span><b>Sesi Kuesioner</b><small>Pantau status sesi yang tersimpan</small></span><span class="arrow">↗</span></a><% if (currentUser.role === 'super_admin') { %><a href="/admin/kuesioner"><span class="quick-icon">03</span><span><b>Master Kuesioner</b><small>Lihat daftar instrumen</small></span><span class="arrow">↗</span></a><% } %></div></section></div><div class="col-xl-4"><section class="content-card h-100"><div class="card-heading"><div><h2>Status aplikasi</h2><p>Informasi dasar lingkungan.</p></div></div><div class="system-status"><span class="status-dot"></span><div><b>Backend aktif</b><small>Express.js · PostgreSQL</small></div></div><div class="system-status"><span class="status-dot status-dot-soft"></span><div><b><%= stats.kuesioner %> instrumen aktif</b><small>Jumlah master dengan status aktif</small></div></div><div class="notice-box"><b>Catatan implementasi</b><p>Modul QR/PIN, perhitungan skor, dan laporan diaktifkan setelah seluruh kolom terkait diverifikasi terhadap database aktual.</p></div></section></div></div>
