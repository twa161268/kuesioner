<% layout('layouts/main') -%>
<div class="participant-shell"><section class="content-card participant-card"><div class="eyebrow">PORTAL PESERTA</div><h1 class="h3 mt-2">Status Tes dan Hasil</h1><p>Peserta: <b><%= sesi.nama_peserta %></b> · Sesi <b><%= sesi.kode_sesi %></b></p><div class="table-responsive"><table class="table"><thead><tr><th>Tes</th><th>Status pengerjaan</th><th>Status hasil</th><th>PDF</th></tr></thead><tbody><% details.forEach(d => { %><tr><td><b><%= d.nama_kuesioner %></b><div class="small text-muted"><%= d.nama_versi || d.kode_versi %></div></td><td><%= d.status_pengerjaan %></td><td><%= d.status_hasil || 'belum dihitung' %></td><td><% if (d.status_hasil === 'diterbitkan') { %><a class="btn btn-sm btn-primary" href="/kuesioner/hasil/<%= token %>/<%= d.sesi_detail_id %>.pdf">Unduh PDF</a><% } else { %><span class="text-muted">Belum tersedia</span><% } %></td></tr><% }) %></tbody></table></div><a class="btn btn-primary" href="/kuesioner/isi/<%= token %>">Mulai / Lanjutkan Tes</a></section></div>