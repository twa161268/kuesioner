<% layout('layouts/main') -%>
<div class="participant-shell"><section class="content-card participant-card"><div class="stat-icon green mx-auto mb-3">✓</div><h1 class="h3">Semua Kuesioner Selesai</h1><p>Terima kasih, <b><%= sesi.nama_peserta %></b>. Tes pada sesi <b><%= sesi.kode_sesi %></b> sudah selesai diisi.</p><p><a href="/kuesioner/hasil/<%= token %>">Lihat status semua tes dan hasil yang sudah terbit</a></p><div class="notice-box"><b>Hasil tes</b><p class="mb-0">PDF hanya dapat diunduh setelah Super Admin menerbitkan hasil tes.</p></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Tes</th><th>Status hasil</th><th>PDF</th></tr></thead><tbody><% details.forEach(d => { %><tr><td><%= d.nama_kuesioner %><div class="small text-muted"><%= d.nama_versi || d.kode_versi %></div></td><td><%= d.status_hasil || 'belum diterbitkan' %></td><td><% if (d.status_hasil === 'diterbitkan') { %><a class="btn btn-sm btn-primary" href="/kuesioner/hasil/<%= token %>/<%= d.sesi_detail_id %>.pdf">Unduh PDF</a><% } else { %><span class="text-muted">Belum tersedia</span><% } %></td></tr><% }) %></tbody></table></div><a href="/" class="btn btn-outline-secondary mt-3">Kembali ke Beranda</a></section></div>